    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cypress": "^16.2.1",
    "cypress-mochawesome-reporter": "^5.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.3",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
