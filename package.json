  "description": "Challenge Tecnico SDET: API (Petstore) y UI (Buggy Cars) con Cypress",
  "scripts": {
    "test": "cypress run",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
